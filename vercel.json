{
  "installCommand": "cd frontend && npm install --legacy-peer-deps",
  "buildCommand": "cd frontend && npx ng build --configuration production",
  "outputDirectory": "frontend/dist/conectar-angular/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://conectar-sj-backend.onrender.com/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://conectar-sj-backend.onrender.com/auth/$1"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
